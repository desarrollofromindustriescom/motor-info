---
import IconSearch from '@icons/search.svg';
import IconClose from '@icons/x.svg';
---

<form
   id="search-form"
   class="bg-white p-1 flex w-1/3 gap-2 outline-2 outline-offset-4 outline-transparent [&:has(input:focus)]:outline-white transition-all"
>
   <input
      type="text"
      placeholder="Buscar..."
      class="placeholder:italic h-8 flex-auto focus:outline-none rounded-xs px-1"
   />
   <button class="flex size-8 items-center justify-center rounded-xs bg-white cursor-pointer">
      <img
         alt="buscar"
         class="size-9/12 svg-to-black"
         data-search-icon={IconSearch.src}
         data-close-icon={IconClose.src}
      />
   </button>
</form>

<script>
   import { groups, handlers } from '@scripts/index';

   const handleClearSearch: typeof handlers.clearSearch = () => {
      if (!formInput || !btnIcon) return;

      formInput.value = '';
      btnIcon.src = btnIcon.dataset.searchIcon || '';
   };

   const handleFormSubmit: (event: Event) => void = (event: Event): void => {
      event.preventDefault();
   };

   const handleInputInput: (event: InputEvent) => void = (): void => {
      if (!btnIcon || !formInput) return;

      handlers.clearFilter();

      const value: string = formInput.value.trim().toLowerCase();
      const filtered: RegisterGroup[] = [];

      if (value === '') {
         btnIcon.src = btnIcon.dataset.searchIcon || '';
         handlers.printRegisters(groups.list);
         return;
      }

      for (let i: number = 0; i < groups.list.length; i++) {
         const selected: Register[] = groups.list[i].registers.filter((register: Register) =>
            register.name.toLowerCase().includes(value),
         );

         if (selected.length === 0) continue;

         filtered.push({
            key: groups.list[i].key,
            registers: selected,
         });
      }

      btnIcon.src = btnIcon.dataset.closeIcon || '';
      handlers.printRegisters(filtered);
   };

   const handleButtonClick: (event: Event) => void = (): void => {
      handlers.clearSearch();
      handlers.printRegisters(groups.list);
   };

   let searchForm: HTMLFormElement | null = null;
   let formInput: HTMLInputElement | null = null;
   let formButton: HTMLButtonElement | null = null;
   let btnIcon: HTMLImageElement | null = null;

   document.addEventListener('DOMContentLoaded', () => {
      searchForm = document.querySelector('#search-form');
      formInput = document.querySelector('#search-form input');
      formButton = document.querySelector('#search-form button');
      btnIcon = document.querySelector('#search-form button img');

      if (!searchForm || !formInput || !formButton || !btnIcon) return;

      handlers.clearSearch = handleClearSearch;

      searchForm.addEventListener('submit', handleFormSubmit);
      formInput.addEventListener('input', handleInputInput);
      formButton.addEventListener('click', handleButtonClick);

      handlers.clearSearch();
   });
</script>
