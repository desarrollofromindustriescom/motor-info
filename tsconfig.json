{
   "extends": "astro/tsconfigs/strict",
   "include": [".astro/types.d.ts", "**/*"],
   "exclude": ["dist"],
   "compilerOptions": {
      "paths": {
         "@env": ["./src/env.ts"],
         "@icons/*": ["./src/assets/icons/*"],
         "@styles/*": ["./src/styles/*"],
         "@scripts/*": ["./src/scripts/*"],
         "@components/*": ["./src/components/*"]
      }
   }
}
